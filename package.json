{
  "name": "@maxhealth.tech/elysia-mcp",
  "version": "2.0.0",
  "description": "Auto-generate MCP tools and resources from Elysia routes via introspection. TypeBox-to-Standard-Schema bridge and tool execution; the HTTP edge lives in @maxhealth.tech/mcp-http.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "elysia",
    "mcp",
    "model-context-protocol",
    "bun",
    "typebox",
    "introspection",
    "auto-generate",
    "tools",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max-Health-Inc/elysia-mcp.git"
  },
  "homepage": "https://github.com/Max-Health-Inc/elysia-mcp#readme",
  "bugs": {
    "url": "https://github.com/Max-Health-Inc/elysia-mcp/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prefab": {
      "types": "./dist/prefab-view.d.ts",
      "import": "./dist/prefab-view.js"
    },
    "./introspect": {
      "types": "./dist/introspect.d.ts",
      "import": "./dist/introspect.js"
    },
    "./typebox-schema": {
      "types": "./dist/typebox-schema.d.ts",
      "import": "./dist/typebox-schema.js"
    },
    "./text-format": {
      "types": "./dist/text-format.d.ts",
      "import": "./dist/text-format.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run check",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run smoke",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.1"
  },
  "peerDependencies": {
    "@maxhealth.tech/prefab": ">=0.3.13",
    "@modelcontextprotocol/server": ">=2.0.0",
    "@sinclair/typebox": ">=0.34.0",
    "elysia": ">=1.2.0"
  },
  "peerDependenciesMeta": {
    "@maxhealth.tech/prefab": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@maxhealth.tech/prefab": "^0.3.13",
    "@modelcontextprotocol/server": "^2.2.0",
    "@sinclair/typebox": "^0.34.52",
    "@types/bun": "^1.4.0",
    "elysia": "^1.4.30",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "private": false,
  "engines": {
    "node": ">=20"
  }
}
